# ===== Supabase (من Project Settings → API) =====
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# مفتاح سري — يُستخدم في الخادم فقط ولا يبدأ بـ NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ===== المدير الرئيسي الأولي =====
# يُنشأ تلقائياً عند أول زيارة لصفحة الدخول إذا لم يوجد مدير رئيسي بعد.
# بعد أول دخول: غيّر كلمة المرور من لوحة التحكم ثم احذف هذين المتغيرين.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-to-a-long-random-password

# ===== إعدادات اختيارية =====
# النطاق الداخلي الذي تُربط به أسماء المستخدمين (لا يُرسل إليه أي بريد)
AUTH_EMAIL_DOMAIN=members.calisthenics-challenge.app
APP_TIMEZONE=Asia/Muscat
